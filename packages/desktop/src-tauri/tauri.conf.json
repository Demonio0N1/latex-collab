{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaTeX Collab",
  "version": "0.1.0",
  "identifier": "com.latexcollab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LaTeX Collab",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/projects/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb"],
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["latexcollab"]
      }
    }
  }
}
